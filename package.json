{
  "name": "skynet-capital",
  "version": "1.76.0",
  "private": true,
  "type": "module",
  "description": "Autonomous options-trading agent personas competing on paper accounts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "export:dashboard": "tsx src/scripts/export-dashboard.ts",
    "serve:dashboard": "tsx src/scripts/serve-dashboard.ts",
    "serve:dashboard:offline": "SKYNET_DATA_SOURCE=offline tsx src/scripts/serve-dashboard.ts",
    "run:autonomous": "tsx src/scripts/run-autonomous.ts",
    "run:autonomous:offline": "SKYNET_DATA_SOURCE=offline tsx src/scripts/run-autonomous.ts",
    "record:session": "tsx src/scripts/record-session.ts",
    "shoot:login": "tsx scripts/shoot-login.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@rstest/core": "^0.2.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "playwright-core": "^1.62.0",
    "semantic-release": "^25.0.8",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
