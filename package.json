{
  "name": "skynet-capital",
  "version": "1.129.0",
  "private": true,
  "type": "module",
  "description": "Autonomous options-trading agent personas competing on paper accounts.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "export:dashboard": "tsx src/scripts/export-dashboard.ts",
    "serve:dashboard": "tsx src/scripts/serve-dashboard.ts",
    "serve:dashboard:offline": "SKYNET_DATA_SOURCE=offline tsx src/scripts/serve-dashboard.ts",
    "eval:persona": "tsx src/scripts/eval-persona.ts",
    "eval:safety": "tsx src/scripts/eval-safety.ts",
    "run:autonomous": "tsx src/scripts/run-autonomous.ts",
    "run:autonomous:offline": "SKYNET_DATA_SOURCE=offline tsx src/scripts/run-autonomous.ts",
    "record:session": "tsx src/scripts/record-session.ts",
    "confirm:print-dates": "tsx src/scripts/confirm-print-dates.ts",
    "brief:morning": "tsx src/scripts/morning-brief.ts",
    "shoot:login": "tsx scripts/shoot-login.mjs",
    "graph:refresh": "bash scripts/refresh-graph.sh",
    "prepare": "test -n \"$CI\" || husky",
    "arch:scan": "node scripts/arch-scan.mjs",
    "dupe:scan": "node scripts/dupe-scan.mjs",
    "clone:scan": "node scripts/clone-scan.mjs",
    "verify": "run-p typecheck lint test",
    "dead:scan": "node scripts/dead-scan.mjs",
    "depgraph:scan": "node scripts/dep-graph-scan.mjs",
    "spec:gap": "node scripts/spec-gap-scan.mjs",
    "incident:scan": "node scripts/incident-scan.mjs",
    "docrot:scan": "node scripts/doc-rot-scan.mjs",
    "build:scene": "esbuild src/three/scene-main.ts --bundle --minify --format=iife --target=es2020 --outfile=public/three/scene.js",
    "shoot:tower": "npm run build:scene && node scripts/shoot-tower.mjs",
    "dev:tower": "node scripts/dev-tower.mjs",
    "smoke:trade": "tsx src/scripts/smoke-trade.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@rstest/core": "0.11.6",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@types/node": "26.2.0",
    "dependency-cruiser": "18.1.1",
    "esbuild": "0.28.1",
    "husky": "9.1.7",
    "jscpd": "5.0.14",
    "knip": "6.32.0",
    "npm-run-all2": "9.0.3",
    "playwright-core": "1.62.1",
    "semantic-release": "25.0.9",
    "tsx": "4.23.11",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@babylonjs/core": "9.20.0"
  }
}
