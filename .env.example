# Per-bot Alpaca PAPER credentials.
#
# Create one paper account per bot under your existing Alpaca account, then paste each
# account's API key/secret below. Naming: SKYNET_BOT_<PERSONA_ID>_KEY / _SECRET, where
# PERSONA_ID is the persona id upper-cased with dashes as underscores.
#
# Copy to .env and fill in. Never commit real keys — .env is gitignored.

# SHARED account — the warm-up shortcut. A persona with no dedicated pair below borrows these, so a
# new strategy can trade an account you already have instead of requiring a brand-new one. Exactly
# ONE enabled persona may borrow it (two bots on one account merge their positions and P/L); if more
# than one would, none do and the runner says so. Give a persona its own pair for clean attribution.
SKYNET_BOT_KEY=
SKYNET_BOT_SECRET=

# News Fader — fades hype, buys panic
SKYNET_BOT_NEWS_FADER_KEY=
SKYNET_BOT_NEWS_FADER_SECRET=

# Retail Investor — buys hype, panic-sells
SKYNET_BOT_RETAIL_INVESTOR_KEY=
SKYNET_BOT_RETAIL_INVESTOR_SECRET=

# Futurist — buys confirmed momentum, ignores news
SKYNET_BOT_FUTURIST_KEY=
SKYNET_BOT_FUTURIST_SECRET=

# Gold Bug — flees to the safe haven on risk-off
SKYNET_BOT_GOLD_BUG_KEY=
SKYNET_BOT_GOLD_BUG_SECRET=

# Human participants — same idea, SKYNET_HUMAN_<NAME>_KEY / _SECRET. The dashboard shows
# them alongside the bots. NAME becomes the display name (ERIC_CLARK -> "Eric Clark").
# _EMAIL links the account to that sign-in ("connects" it): the desk, the /u portfolio, and
# self-rotation all resolve through this link. Without it the account syncs but belongs to
# no session. Also rotatable at runtime via /rotate — the store's rotated key then overrides
# the _KEY/_SECRET here until you update them.
# SKYNET_HUMAN_ERIC_CLARK_KEY=
# SKYNET_HUMAN_ERIC_CLARK_SECRET=
# SKYNET_HUMAN_ERIC_CLARK_EMAIL=

# Optional: override the paper endpoint (defaults to https://paper-api.alpaca.markets)
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Live dashboard server (npm run serve:dashboard)
# SKYNET_DASHBOARD_PORT=8787
# Legacy shared-password gate (used only when OAuth below is NOT configured).
# Browsers then need ?key=<password>. Prefer OAuth for anything public.
# SKYNET_DASHBOARD_PASSWORD=

# Per-user login (OAuth). When SKYNET_SESSION_SECRET + at least one provider are set, the
# dashboard replaces ?key= with real Google/GitHub sign-in and a signed session cookie.
# SKYNET_SESSION_SECRET=          # long random string; signs session cookies (openssl rand -hex 32)
# SKYNET_GOOGLE_CLIENT_ID=
# SKYNET_GOOGLE_CLIENT_SECRET=
# SKYNET_GITHUB_CLIENT_ID=
# SKYNET_GITHUB_CLIENT_SECRET=
# Allowlist — only these people may sign in. At least one is required or nobody gets in.
# SKYNET_ALLOWED_EMAILS=you@gmail.com,brother@gmail.com
# SKYNET_ALLOWED_GITHUB_LOGINS=ejclark   # optional; for GitHub users whose email is private

# Self-service onboarding (the /add form). Accounts people add at runtime are persisted here.
# SKYNET_PARTICIPANT_STORE=data/participants.json
# Encrypts stored credentials at rest (AES-256-GCM). REQUIRED before exposing /add publicly —
# without it, submitted keys are written in plaintext.
# SKYNET_STORE_SECRET=

# Equity/realized-P/L history samples (the performance-over-time layer). Defaults to data/history;
# production points this at the mounted volume (see fly.toml) so history survives redeploys.
# SKYNET_HISTORY_DIR=data/history
# Autonomous decision audit trail (JSONL per persona). Unset = decisions are console-logged only,
# and the /u/:id decisions panel stays on its "not recorded yet" seam.
# SKYNET_AUDIT_DIR=data/audit

# Offline mode — run the dashboard/autonomous loop from fixtures, no keys, no network.
# Use `npm run serve:dashboard:offline` / `run:autonomous:offline` instead of setting this by hand.
# SKYNET_DATA_SOURCE=offline
# SKYNET_OFFLINE_FIXTURES=fixtures/offline
