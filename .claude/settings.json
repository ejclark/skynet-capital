{
  "outputStyle": "Orient",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/setup-commit-signing.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/duel-log.mjs fanout 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/duel-log.mjs fanin 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/duel-log.mjs intent 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm test*)",
      "Bash(npx rstest run *)",
      "Bash(npm run verify)",
      "Bash(npx tsc *)",
      "Bash(npx knip *)",
      "Bash(npx biome check .)",
      "Bash(node scripts/issue-lint.mjs *)",
      "Bash(node scripts/envelope-scan.mjs *)",
      "Bash(node scripts/arch-scan.mjs)",
      "Bash(node scripts/dupe-scan.mjs)",
      "Bash(node scripts/clone-scan.mjs)",
      "Bash(node scripts/dead-scan.mjs)",
      "Bash(node scripts/spec-gap-scan.mjs)",
      "Bash(node scripts/doc-rot-scan.mjs)",
      "Bash(node scripts/incident-scan.mjs)",
      "Bash(node scripts/digest-scan.mjs *)",
      "mcp__github__enable_pr_auto_merge",
      "mcp__github__update_pull_request",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__claude-code-remote__subscribe_pr_activity",
      "mcp__claude-code-remote__unsubscribe_pr_activity",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__delete_trigger",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__delete_trigger"
    ]
  }
}
