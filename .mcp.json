{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser=chromium",
        "--executable-path=/opt/pw-browsers/chromium"
      ]
    },
    "babylon-mcp": {
      "type": "http",
      "url": "http://localhost:4000/mcp"
    }
  }
}
