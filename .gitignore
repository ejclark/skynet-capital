# No trailing slash: athlete worktrees get node_modules as a SYMLINK
# (scripts/worktree-setup.sh), and `node_modules/` matches only real directories.
node_modules
dist/
coverage/
data/
*.log
.env
.env.*
!.env.example

# Graphify generated knowledge-graph outputs (regenerate with: graphify extract . --code-only)
graphify-out/

# Scratchpad / throwaway preview + shoot scripts (never committed)
scratchpad/
.claude/worktrees/

# Mirrored Claude Code docs — a cache, never a source (refresh: node scripts/fetch-claude-docs.mjs)
.cache/claude-docs/

# Claude's SSH commit-signing key material (scripts/setup-commit-signing.sh writes it
# to ~/.ssh at session start, never here). Ignored belt-and-braces: a signing key is
# the irreversible class, and a stray copy must not be trackable by accident.
*signing_key*
claude_signing*
allowed_signers

# Built Babylon scene bundle + the harness's staged shell (see npm run build:scene).
# The bundle is generated from src/three/** at install time, never committed.
public/three/scene.js
public/tower.html

# Claude Code per-machine settings (harness convention — never committed).
.claude/settings.local.json

# macOS Finder metadata. Not just tidiness: unzipping a Claude Design bundle in Finder writes a
# .DS_Store INSIDE docs/handoffs/<slug>/, where it would be committed as part of the bundle, listed
# as a bundle file by scripts/handoff-scan.mjs, and shown to a building session in the watcher's
# issue body as though it were design input.
.DS_Store
